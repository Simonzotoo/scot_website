# Copy this file to .env and fill in real values for this deployment.
# .env is gitignored — never commit real credentials.

# MySQL connection — on Hostinger, create the database + a dedicated DB
# user from hPanel first, then fill these in with those exact values.
DB_HOST=127.0.0.1
DB_NAME=
DB_USER=
DB_PASS=

# development | production — MUST be "production" on the live site: it
# turns off on-screen PHP errors, forces HTTPS, and adds HSTS. Only use
# "development" on a local/staging copy.
APP_ENV=development

# Leave unset to auto-detect from the document root. Only set this if the
# app is served through a reverse proxy that rewrites the path.
#APP_BASE_URL=

# Set to 1 only if a trusted reverse proxy sits in front of this app and
# sets X-Forwarded-Proto itself (e.g. a load balancer terminating TLS).
# Leave at 0 if PHP is directly internet-facing.
TRUST_PROXY_HEADERS=0

# Absolute production URL (no trailing slash) — used for the sitemap,
# canonical link, and Open Graph tags, which all require a fully-qualified
# URL rather than a relative one.
SITE_URL=https://scotwiuc.com

# GA4 "G-XXXXXXXXXX" measurement ID. Leave blank to disable Google
# Analytics entirely — the site works fine without it. Only fires after a
# visitor accepts the cookie banner (see assets/js/consent.js).
GA_MEASUREMENT_ID=
